{
  "name": "skill-rails",
  "version": "0.3.0",
  "description": "Deterministic, testable YAML flows for AI agent skills, in GitHub Actions syntax.",
  "type": "module",
  "license": "MIT",
  "bin": "bin/skill-rails.js",
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    },
    "./schema": "./schema/flow.schema.json"
  },
  "files": [
    "bin",
    "dist",
    "schema",
    "skills",
    "docs",
    "examples",
    ".claude-plugin",
    ".mcp.json",
    "plugin.json",
    "mcp.json",
    ".codex-plugin",
    ".agents/plugins/marketplace.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "yarn build && vitest run",
    "prepack": "yarn build",
    "prepublishOnly": "yarn typecheck && yarn test"
  },
  "keywords": [
    "agent",
    "skills",
    "claude-code",
    "workflow",
    "mcp",
    "llm",
    "github-actions"
  ],
  "dependencies": {
    "@actions/expressions": "^0.3.61",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ajv": "^8.17.1",
    "js-yaml": "^4.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  },
  "author": {
    "name": "Juani Galán",
    "url": "https://github.com/juanigalan91"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juanigalan91/skill-rails.git"
  },
  "homepage": "https://github.com/juanigalan91/skill-rails#readme",
  "bugs": {
    "url": "https://github.com/juanigalan91/skill-rails/issues"
  },
  "main": "./dist/api.js",
  "types": "./dist/api.d.ts",
  "packageManager": "yarn@4.18.0"
}
