{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__.*rails_done",
        "hooks": [
          {
            "type": "command",
            "command": "i=$(cat); case \"$i\" in *rails_done*|*skill-rails*done*) printf '%s' \"$i\" | npx -y skill-rails@0.5 hook;; esac",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion|request_user_input",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y skill-rails@0.5 hook",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
